{
  "name": "fk-web",
  "version": "1.0.0",
  "description": "Website for Guild of Physics",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "generate:migration": "payload migrate:create --skip-empty",
    "generate:payload": "pnpm generate:importmap && pnpm generate:types && pnpm generate:migration",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "migrate": "payload migrate",
    "payload": "payload",
    "start": "next start",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@date-fns/tz": "^1.5.0",
    "@payloadcms/admin-bar": "^3.91.0",
    "@payloadcms/db-postgres": "^3.91.0",
    "@payloadcms/email-nodemailer": "^3.91.0",
    "@payloadcms/live-preview-react": "^3.91.0",
    "@payloadcms/next": "^3.91.0",
    "@payloadcms/plugin-form-builder": "^3.91.0",
    "@payloadcms/plugin-import-export": "^3.91.0",
    "@payloadcms/plugin-redirects": "^3.91.0",
    "@payloadcms/plugin-seo": "^3.91.0",
    "@payloadcms/richtext-lexical": "^3.91.0",
    "@payloadcms/storage-s3": "^3.91.0",
    "@payloadcms/ui": "^3.91.0",
    "@plaiceholder/next": "^3.0.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "compress-pdf": "^0.6.3",
    "date-fns": "^4.4.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "nextjs-toploader": "^3.9.17",
    "payload": "^3.91.0",
    "payload-oauth2": "^1.0.21",
    "plaiceholder": "^3.0.0",
    "react": "^19.3.1",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "react-social-icons": "^6.27.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "simple-git-hooks": "^2.14.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "NODE_OPTIONS='--experimental-strip-types' pnpm exec lint-staged"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": "^12"
  },
  "packageManager": "pnpm@12.14.0"
}
