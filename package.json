{
  "name": "fk-web",
  "version": "1.0.0",
  "description": "Website for Guild of Physics",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "typegen": "next typegen",
    "typecheck": "tsc --noEmit",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "generate:migration": "payload migrate:create --skip-empty",
    "generate:payload": "pnpm generate:importmap && pnpm generate:types && pnpm generate:migration",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint .",
    "migrate": "payload migrate",
    "payload": "payload",
    "start": "next start",
    "preinstall": "npx only-allow pnpm",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@date-fns/tz": "^1.5.0",
    "@payloadcms/admin-bar": "^3.88.0",
    "@payloadcms/db-postgres": "^3.88.0",
    "@payloadcms/email-nodemailer": "^3.88.0",
    "@payloadcms/live-preview-react": "^3.88.0",
    "@payloadcms/next": "^3.88.0",
    "@payloadcms/plugin-form-builder": "^3.88.0",
    "@payloadcms/plugin-import-export": "^3.88.0",
    "@payloadcms/plugin-redirects": "^3.88.0",
    "@payloadcms/plugin-seo": "^3.88.0",
    "@payloadcms/richtext-lexical": "^3.88.0",
    "@payloadcms/storage-s3": "^3.88.0",
    "@payloadcms/ui": "^3.88.0",
    "@plaiceholder/next": "^3.0.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "compress-pdf": "^0.6.3",
    "date-fns": "^4.4.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.33.0",
    "next": "^16.3.2",
    "next-intl": "^4.13.7",
    "nextjs-toploader": "^3.9.17",
    "payload": "^3.88.0",
    "payload-oauth2": "^1.0.21",
    "plaiceholder": "^3.0.0",
    "react": "^19.2.8",
    "react-big-calendar": "^1.20.0",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.2",
    "react-social-icons": "^6.26.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "simple-git-hooks": "^2.13.1",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "NODE_OPTIONS='--experimental-strip-types' pnpm exec lint-staged"
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": "^11"
  },
  "packageManager": "pnpm@11.22.0"
}
